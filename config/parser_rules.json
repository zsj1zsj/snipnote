      "text_replacements": [
        {"pattern": "\\[\\[\\s*参\\d+\\s*\\]\\]\\(#[^)]*\\)", "to": ""},
        {"pattern": "\\[\\[\\s*\\d+\\s*\\]\\]\\([^)]*\\)", "to": ""},
        {"pattern": "\\[\\d+\\]", "to": ""},
        {"pattern": "\\[来源请求\\]", "to": ""},
        {"pattern": "\\[编辑\\]", "to": ""},
        {"pattern": "\\[注\\s*\\d*\\]", "to": ""},
        {"pattern": "\\[\\s*edit\\s*\\]", "to": ""},
        {"pattern": "\\[([^\\]]+)\\]\\(/wiki/(?:[^()]*|\\([^)]*\\))*\\)", "to": "\\1"},
        {"pattern": "\\[([^\\]]+)\\]\\(/w/(?:[^()]*|\\([^)]*\\))*\\)", "to": "\\1"},
        {"pattern": "\\[([^\\]]+)\\]\\(https?://[a-z]{2,3}\\.wikipedia\\.org/(?:[^()]*|\\([^)]*\\))*\\)", "to": "\\1"},
        {"pattern": "\\[([^\\]]+)\\]\\(#[^)]+\\)", "to": ""},
