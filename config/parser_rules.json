        "^繁體$",
        "^大陆简体$",
        "^香港繁體$",
        "^澳門繁體$",
        "^大马简体$",
        "^新加坡简体$",
        "^臺灣正體$",
        "^上传文件$",
        "^可打印版$",
        "^维基共享资源$",
        "^维基数据项目$",
        "^今属于",
        "^This article has multiple issues",
        "^Please help improve",
        "^This article needs additional citations"
      ],
      "stop_patterns": [
        "^参考文献$",
        "^注释$",
        "^外部链接$",
        "^延伸阅读$",
        "^References$",
        "^External links$",
        "^See also$",
        "^另见$"
